# ---------------------------------------------------------------
# 默认无需任何配置即可启动：不填 MYSQL_HOST 时使用内置 SQLite。
# 需要这份文件只在你打算切换到 MySQL / Neo4j，或配置系统兜底 Key 时。
# 使用者的个人 Key 请在界面「个人设置」里填，不用写在这里。
# ---------------------------------------------------------------

# 运行环境：development / production / test
ENV=development

# ---------------- 数据库（可选 MySQL，默认 SQLite）----------------
# 填了 MYSQL_HOST 才走 MySQL；留空则使用 backend/data/app.db
# DATABASE_URL=sqlite:///./data/app.db
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_qa_core

# ---------------- Neo4j（可选）----------------
# 未部署时图谱检索自动降级跳过，不影响问答
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------------- JWT ----------------
# 务必替换成自己的随机字符串，生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 若保留下面的占位值，等同于使用公开已知密钥，令牌可被伪造。
# 留空不填时，服务会在每次启动时随机生成（重启后需重新登录）。
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 是否开放免登录的「创建首个管理员」接口（POST /api/v1/auth/init）
# 默认关闭。本地演示要用该接口时改为 true；正式环境务必保持 false。
ALLOW_INIT_ADMIN=false

# ---------------- AI 服务（系统兜底值，可选）----------------
# 仅在使用者未在「个人设置」里配置时生效。
# 建议留空，让每位使用者用自己的 Key 与额度。
LLM_MODEL=qwen3.7-plus
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
