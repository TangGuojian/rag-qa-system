# ---------------------------------------------------------------
# 默认无需任何配置即可启动：不填 MYSQL_HOST 时使用内置 SQLite。
# 需要这份文件只在你打算切换到 MySQL / Neo4j，或配置系统兜底 Key 时。
# 使用者的个人 Key 请在界面「个人设置」里填，不用写在这里。
# ---------------------------------------------------------------

# 运行环境：development / production / test
ENV=development

# ---------------- 数据库（可选 MySQL，默认 SQLite）----------------
# 填了 MYSQL_HOST 才走 MySQL；留空则使用 backend/data/app.db
# DATABASE_URL=sqlite:///./data/app.db
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_qa_core

# ---------------- Neo4j（可选）----------------
# 未部署时图谱检索自动降级跳过，不影响问答
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------------- JWT ----------------
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------------- AI 服务（系统兜底值，可选）----------------
# 仅在使用者未在「个人设置」里配置时生效。
# 建议留空，让每位使用者用自己的 Key 与额度。
LLM_MODEL=qwen3.7-plus
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
